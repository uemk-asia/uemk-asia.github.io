---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Button from '../components/Button.astro';
import { site } from '../config/site';
---
<BaseLayout title="Join" description="Find out how to get involved with UEMK ASIA and explore AI safety and alignment.">
  <PageHeader eyebrow="Get involved" title="Bring your curiosity." lead="Whether you are new to AI safety or have experience with the field, there is room to learn together." />
  <div class="container-page grid gap-12 py-20 lg:grid-cols-[1.3fr_1fr] lg:gap-20">
    <div class="prose-body"><h2>Who can participate?</h2><p>Students, faculty, researchers, alumni, and prospective collaborators interested in AI safety and alignment are welcome to explore the initiative. No prior experience in AI safety is needed.</p><h2>Ways to get involved</h2><p>As the initiative develops, there may be opportunities to read and discuss research, help organize activities, explore projects, or share knowledge with others. Specific opportunities will be announced when confirmed.</p><p>For a place to begin today, browse the <a href="/resources/">learning resources</a> and check the <a href="/activities/">activities page</a> for updates.</p></div>
    <aside><div class="rounded-lg border border-border bg-surface p-7 sm:p-9"><h2 class="text-2xl font-semibold">Join UEMK ASIA</h2>{site.joinFormUrl ? <><p class="mt-3 leading-relaxed text-muted">Use the external form to express your interest in the initiative.</p><Button href={site.joinFormUrl} external class="mt-6">Join UEMK ASIA</Button></> : <p class="mt-3 leading-relaxed text-muted">An application or contact link will be shared here when it is available. Please check back for updates.</p>}{site.contactEmail && <p class="mt-6 text-sm">Contact: <a class="link" href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a></p>}{site.socials.length > 0 && <ul class="mt-5 space-y-2 text-sm">{site.socials.map((social) => <li><a class="link" href={social.url} target="_blank" rel="noopener noreferrer">{social.label}<span class="sr-only"> (opens in a new tab)</span> ↗</a></li>)}</ul>}</div></aside>
  </div>
</BaseLayout>
