---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { areasOfInterest, site, values } from '../config/site';
---
<BaseLayout title="About" description="Learn about the mission, interests, and values of UEMK ASIA at UEM Kolkata.">
  <PageHeader eyebrow="About UEMK ASIA" title="A place to think carefully about AI." lead="An emerging initiative for people interested in understanding and improving the safety and alignment of AI systems." />
  <section id="mission" class="container-page grid scroll-mt-24 gap-8 py-20 md:grid-cols-[1fr_2fr]">
    <div><p class="eyebrow">Our purpose</p><h2 class="mt-3 text-3xl font-semibold">Mission &amp; vision</h2></div>
    <div class="prose-body">
      <p>UEMK ASIA, the {site.fullName}, aims to bring together students, faculty, and researchers at UEM Kolkata to learn about AI safety and alignment and engage with questions in the field.</p>
      <p>The initiative was conceived to give interested people a shared starting point: a place to build foundations, discuss ideas critically, and explore research together. Its long-term vision is a thoughtful, collaborative community equipped to contribute to safer AI.</p>
      <p>UEMK ASIA is an initiative at the {site.institution}; it does not speak for the university as a whole. The initiative is at an early stage, and confirmed activities will be shared on this site.</p>
    </div>
  </section>
  <section class="border-y border-border bg-surface"><div class="container-page py-20">
    <p class="eyebrow">Questions we can explore</p><h2 class="mt-3 text-3xl font-semibold">Areas of interest</h2>
    <p class="mt-4 max-w-2xl text-muted">These are proposed areas of interest, subject to organizer review as the initiative develops.</p>
    <div class="mt-10 grid gap-x-10 gap-y-8 md:grid-cols-2">{areasOfInterest.map((area) => <article class="border-t border-border pt-5"><h3 class="text-xl font-semibold">{area.title}</h3><p class="mt-2 leading-relaxed text-muted">{area.description}</p></article>)}</div>
  </div></section>
  <section class="container-page py-20"><p class="eyebrow">How we work</p><h2 class="mt-3 text-3xl font-semibold">Values</h2><div class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">{values.map((value) => <article><h3 class="text-xl font-semibold">{value.title}</h3><p class="mt-3 leading-relaxed text-muted">{value.description}</p></article>)}</div></section>
</BaseLayout>
