---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
---
<BaseLayout title="Page not found" description="The requested page could not be found." noindex>
  <section class="container-page py-24 sm:py-32"><p class="eyebrow">404</p><h1 class="mt-4 text-4xl font-semibold sm:text-5xl">Page not found.</h1><p class="mt-5 max-w-lg text-lg text-muted">The page may have moved or the address may be incorrect. You can return to the homepage or explore our resources.</p><div class="mt-8 flex flex-wrap gap-3"><Button href="/">Go home</Button><Button href="/resources/" variant="secondary">Explore resources</Button></div></section>
</BaseLayout>
