---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import ResourceCard from '../components/ResourceCard.astro';
import { allResources, resourceGroups } from '../lib/data';
const byId = new Map(allResources.map((item) => [item.id, item]));
---
<BaseLayout title="Resources" description="Explore introductory AI safety resources, technical research directions, governance, courses, and fellowships.">
  <PageHeader eyebrow="Learning hub" title="Resources" lead="Explore introductions, research directions, and learning opportunities in AI safety and alignment. External resources reflect a range of perspectives and do not imply affiliation." />
  <div class="container-page py-16">
    {resourceGroups.length > 0 && <nav aria-label="Resource categories" class="flex flex-wrap gap-x-5 gap-y-3">{resourceGroups.map((section) => <a href={`#${section.id}`} class="text-sm font-medium text-accent-text underline underline-offset-4">{section.title}</a>)}</nav>}
    {resourceGroups.map((section) => <section id={section.id} class="scroll-mt-24 pt-16">
      <h2 class="text-3xl font-semibold">{section.title}</h2>
      {section.description && <p class="mt-3 max-w-3xl leading-relaxed text-muted">{section.description}</p>}
      {section.resources.length > 0 && <div class="mt-7 grid gap-x-10 md:grid-cols-2 lg:grid-cols-3">{section.resources.map((resource) => <ResourceCard resource={resource} />)}</div>}
      {section.related.length > 0 && <p class="mt-5 text-sm leading-relaxed text-muted">Related: {section.related.map((ref, i) => <><a class="link" href={`#${ref}`}>{byId.get(ref)?.title}</a>{i < section.related.length - 1 ? ' · ' : ''}</>)}</p>}
      {section.groups.map((group) => <section id={group.id} class="scroll-mt-24 pt-10">
        <h3 class="text-2xl font-semibold">{group.title}</h3>
        {group.description && <p class="mt-3 max-w-3xl leading-relaxed text-muted">{group.description}</p>}
        {group.resources.length > 0 && <div class="mt-6 grid gap-x-10 md:grid-cols-2 lg:grid-cols-3">{group.resources.map((resource) => <ResourceCard resource={resource} headingLevel="h4" />)}</div>}
        {group.related.length > 0 && <p class="mt-2 text-sm leading-relaxed text-muted">Related: {group.related.map((ref, i) => <><a class="link" href={`#${ref}`}>{byId.get(ref)?.title}</a>{i < group.related.length - 1 ? ' · ' : ''}</>)}</p>}
      </section>)}
    </section>)}
  </div>
</BaseLayout>
