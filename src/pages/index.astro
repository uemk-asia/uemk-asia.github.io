---
import BaseLayout from '../layouts/BaseLayout.astro';
import EventCard from '../components/EventCard.astro';
import { groupEvents, homepage } from '../lib/data';
const { upcoming, past } = groupEvents();
---
<BaseLayout>
  <section class="container-page py-20 sm:py-28 lg:py-32"><div class="max-w-4xl fade-up"><p class="eyebrow leading-relaxed"><span class="block">{homepage.eyebrow}</span><span class="block">{homepage.eyebrowInstitution}</span></p><h1 class="mt-5 text-4xl leading-[1.1] font-semibold tracking-tight sm:text-5xl lg:text-6xl">{homepage.headline}</h1><p class="mt-7 max-w-2xl text-lg leading-relaxed text-muted sm:text-xl">{homepage.introduction}</p><a href="#mission" class="mt-8 inline-flex rounded-md bg-accent px-5 py-3 font-medium text-accent-fg hover:bg-accent-hover">Our mission <span aria-hidden="true" class="ml-3">↓</span></a></div></section>
  <section id="mission" class="scroll-mt-24 border-y border-border bg-surface"><div class="container-page grid gap-6 py-20 md:grid-cols-[1fr_2fr] md:gap-16"><div><p class="eyebrow">What guides us</p><h2 class="mt-3 text-3xl font-semibold">Our mission</h2></div><p class="max-w-3xl font-serif text-2xl leading-relaxed sm:text-3xl">{homepage.mission}</p></div></section>
  <section class="container-page py-20 sm:py-24"><div class="grid gap-7 md:grid-cols-[1fr_2fr] md:gap-16"><div><p class="eyebrow">Gather &amp; learn</p><h2 class="mt-3 text-3xl font-semibold">Upcoming events</h2></div><div>{upcoming.length ? upcoming.map((event) => <EventCard event={event} />) : <p class="border-t border-border py-6 leading-relaxed text-muted">There are no upcoming events announced yet. Please check back for updates.</p>}{past.length > 0 && <section class="mt-12"><h3 class="mb-5 text-2xl font-semibold">Past events</h3>{past.map((event) => <EventCard event={event} />)}</section>}</div></div></section>
  <section class="border-t border-border"><div class="container-page grid gap-6 py-20 md:grid-cols-[1fr_2fr] md:gap-16"><div><p class="eyebrow">Our community</p><h2 class="mt-3 text-3xl font-semibold">About UEMK ASIA</h2></div><div><p class="max-w-2xl text-lg leading-relaxed text-muted">{homepage.about}</p><p class="mt-6"><a class="link font-medium" href="/resources/">Explore learning resources →</a></p></div></div></section>
</BaseLayout>
