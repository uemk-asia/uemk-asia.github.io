---
import { initials, photoFor, type Person } from '../lib/people';

interface Props {
  person: Person;
  /** Rendered size in pixels (square). */
  size: number;
  /** Load immediately (profile header) instead of lazily (directory). */
  eager?: boolean;
  class?: string;
}

const { person, size, eager = false, class: extra } = Astro.props;
const photo = photoFor(person);
---

{
  photo ? (
    <img
      src={photo}
      alt={`Photo of ${person.data.name}`}
      width={size}
      height={size}
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
      style={{ width: `${size}px`, height: `${size}px` }}
      class:list={['shrink-0 rounded-full bg-surface object-cover', extra]}
    />
  ) : (
    <span
      aria-hidden="true"
      style={{ width: `${size}px`, height: `${size}px`, fontSize: `${Math.round(size / 3.2)}px` }}
      class:list={['grid shrink-0 place-items-center rounded-full bg-accent-soft font-serif text-accent-text', extra]}
    >
      {initials(person.data.name)}
    </span>
  )
}
