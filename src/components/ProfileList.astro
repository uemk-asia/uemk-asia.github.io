---
/** A titled list on a profile page (projects, publications, talks, awards). */
interface Item {
  title: string;
  url?: string;
  detail?: string;
  meta?: string;
}

interface Props {
  id: string;
  title: string;
  items: Item[];
}

const { id, title, items } = Astro.props;
const headingId = `${id}-heading`;
---

<section aria-labelledby={headingId}>
  <h2 id={headingId} class="text-2xl font-semibold">{title}</h2>
  <ul class="mt-4">
    {items.map((item) => (
      <li class="border-t border-border py-4">
        <div class="font-medium text-fg">
          {item.url ? (
            <a href={item.url} target="_blank" rel="noopener noreferrer" class="link">
              {item.title}<span class="sr-only"> (opens in a new tab)</span> ↗
            </a>
          ) : (
            <span>{item.title}</span>
          )}
        </div>
        {item.detail && <p class="mt-1 text-sm leading-relaxed text-muted">{item.detail}</p>}
        {item.meta && <p class="mt-1 text-sm text-muted">{item.meta}</p>}
      </li>
    ))}
  </ul>
</section>
