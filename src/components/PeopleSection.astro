---
import type { PeopleSection } from '../lib/people';
import PersonCard from './PersonCard.astro';
interface Props { section: PeopleSection }
const { section } = Astro.props;
---
{(section.members.length > 0 || section.emptyPlaceholder) && <section id={section.id} aria-labelledby={`${section.id}-heading`} class="scroll-mt-24"><h2 id={`${section.id}-heading`} class="text-3xl font-semibold">{section.title}</h2>{section.description && <p class="mt-3 max-w-2xl leading-relaxed text-muted">{section.description}</p>}{section.members.length ? <div class="mt-7 grid gap-5 md:grid-cols-2">{section.members.map((person) => <PersonCard person={person} />)}</div> : <p class="mt-5 border-t border-border pt-5 text-muted">{section.emptyPlaceholder}</p>}</section>}
