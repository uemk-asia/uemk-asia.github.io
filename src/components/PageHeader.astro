---
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  /** Less vertical padding, so the page content starts sooner. */
  compact?: boolean;
}

const { eyebrow, title, lead, compact = false } = Astro.props;
---

<header class="border-b border-border bg-surface">
  <div class:list={['container-page fade-up', compact ? 'py-8 sm:py-10' : 'py-14 sm:py-20']}>
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1 class="mt-3 max-w-3xl text-4xl font-semibold tracking-tight sm:text-5xl">{title}</h1>
    {lead && <p class:list={[compact ? 'mt-3' : 'mt-5', 'max-w-2xl text-lg leading-relaxed text-muted']}>{lead}</p>}
    <slot />
  </div>
</header>
