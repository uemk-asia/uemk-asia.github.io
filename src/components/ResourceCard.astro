---
import type { Resource } from '../lib/data';
interface Props { resource: Resource; headingLevel?: 'h3' | 'h4' }
const { resource, headingLevel: Heading = 'h3' } = Astro.props;
const { id, title, description, url, level, format, source, type, organization, featured } = resource;
const host = new URL(url).hostname.replace(/^www\./, '');
---
<article id={id} class="scroll-mt-24 border-t border-border py-6">
  <Heading class="font-serif text-xl font-semibold leading-snug"><a href={url} target="_blank" rel="noopener noreferrer" class="hover:text-accent-text hover:underline">{title}<span class="sr-only"> (opens in a new tab)</span> ↗</a></Heading>
  {(organization || source) && <p class="mt-1 text-sm text-muted">{organization || source}</p>}
  <p class="mt-3 leading-relaxed text-muted">{description}</p>
  <p class="mt-4 flex flex-wrap gap-x-3 gap-y-1 text-xs font-medium text-muted">{level && <span>{level}</span>}{(type || format) && <span>{type || format}</span>}{featured && <span>Featured</span>}<span>{host}</span></p>
</article>
