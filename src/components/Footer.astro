---
import Wordmark from './Wordmark.astro';
import { nav, site } from '../config/site';
import { getPeopleSections } from '../lib/people';

// People with a public email in their profile, from People-page sections that
// have "showInFooter" enabled (faculty advisors are excluded in people-sections.json).
const contacts = (await getPeopleSections())
  .filter((section) => section.showInFooter)
  .flatMap((section) => section.members)
  .filter((person) => person.data.email);

const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-border bg-surface">
  <div class="container-page grid gap-10 py-12 md:grid-cols-[1.4fr_1fr_1fr]">
    <div>
      <Wordmark />
      <p class="mt-4 max-w-sm text-sm leading-relaxed text-muted">
        {site.shortName} is an AI Safety & Alignment initiative at the {site.institution}.
      </p>
    </div>

    <nav aria-label="Footer">
      <h2 class="font-sans text-sm font-semibold text-fg">Pages</h2>
      <ul class="mt-3 space-y-2 text-sm">
        {
          nav.map((item) => (
            <li>
              <a href={item.href} class="text-muted hover:text-fg hover:underline">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div>
      <h2 class="font-sans text-sm font-semibold text-fg">Connect</h2>
      <ul class="mt-3 space-y-2 text-sm">
        {
          site.contactEmail && (
            <li>
              <a href={`mailto:${site.contactEmail}`} class="text-muted hover:text-fg hover:underline">
                {site.contactEmail}
              </a>
            </li>
          )
        }
        {
          site.socials.map((s) => (
            <li>
              <a href={s.url} class="text-muted hover:text-fg hover:underline" target="_blank" rel="noopener noreferrer">
                {s.label}<span class="sr-only"> (opens in a new tab)</span>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="mt-3 text-sm leading-relaxed text-muted">Reach out to the organizers over email:</p>
      {
        contacts.length > 0 && (
          <ul class="mt-2 space-y-2 text-sm">
            {contacts.map((person) => (
              <li>
                <a href={`mailto:${person.data.email}`} class="text-muted hover:text-fg hover:underline break-all">{person.data.email}</a>
                <span class="block text-xs text-muted">{person.data.name}</span>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </div>
  <div class="border-t border-border">
    <p class="container-page py-5 text-xs text-muted">© {year} {site.shortName}</p>
  </div>
</footer>
