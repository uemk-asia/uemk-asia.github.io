---
interface Props {
  href: string;
  variant?: 'primary' | 'secondary';
  size?: 'md' | 'lg';
  /** Opens an external site; opens in a new tab and adds an arrow icon. */
  external?: boolean;
  class?: string;
}

const { href, variant = 'primary', size = 'md', external = false, class: extra } = Astro.props;

const variants = {
  primary: 'bg-accent text-accent-fg hover:bg-accent-hover border border-transparent',
  secondary: 'border border-border bg-bg text-fg hover:border-accent hover:text-accent-text',
};
const sizes = {
  md: 'px-4 py-2.5 text-sm',
  lg: 'px-5 py-3 text-base',
};
---

<a
  href={href}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
  class:list={[
    'inline-flex items-center justify-center gap-2 rounded-md font-medium transition-colors',
    variants[variant],
    sizes[size],
    extra,
  ]}
>
  <slot />
  {external && <span class="sr-only"> (opens in a new tab)</span>}
  {
    external && (
      <svg class="h-4 w-4" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M7 13L13 7M8 7h5v5" />
      </svg>
    )
  }
</a>
