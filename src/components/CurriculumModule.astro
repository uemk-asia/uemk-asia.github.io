---
import ReadingList from './ReadingList.astro';
import type { CurriculumModule } from '../lib/data';

interface Props {
  module: CurriculumModule;
  /** Eyebrow text, e.g. "Module 3" or "Preparation 1". */
  label: string;
}

const { module, label } = Astro.props;
const { id, title, description, weeks, badge, topics, readings, assignments, resources } = module;
const headingId = `${id}-heading`;
---

<section id={id} aria-labelledby={headingId} class="scroll-mt-24 rounded-lg border border-border p-6 sm:p-8">
  <p class="flex flex-wrap items-center gap-x-3 gap-y-1 font-serif text-sm text-accent-text">
    <span>{label}</span>
    {weeks && <span class="font-sans text-muted">{weeks}</span>}
    {badge && <span class="rounded-full bg-accent-soft px-2.5 py-0.5 font-sans text-xs font-medium text-accent-text">{badge}</span>}
  </p>
  <h4 id={headingId} class="mt-1 font-serif text-2xl font-semibold">{title}</h4>
  {description && <p class="mt-3 max-w-3xl leading-relaxed text-muted">{description}</p>}

  <div class="mt-6 grid gap-8 md:grid-cols-2">
    {
      topics.length > 0 && (
        <div>
          <h5 class="text-sm font-semibold tracking-wide text-muted uppercase">Topics covered</h5>
          <ul class="mt-3 list-disc space-y-1.5 pl-5 leading-relaxed marker:text-muted">
            {topics.map((topic) => <li>{topic}</li>)}
          </ul>
        </div>
      )
    }
    {
      readings.length > 0 && (
        <div>
          <h5 class="text-sm font-semibold tracking-wide text-muted uppercase">Recommended readings</h5>
          <div class="mt-3"><ReadingList items={readings} /></div>
        </div>
      )
    }
    {
      assignments.length > 0 && (
        <div>
          <h5 class="text-sm font-semibold tracking-wide text-muted uppercase">Assignments &amp; exercises</h5>
          <ul class="mt-3 space-y-3">
            {assignments.map((assignment) => (
              <li class="leading-relaxed">
                <span class="font-medium text-fg">{assignment.title}</span>
                {assignment.description && <span class="block text-sm text-muted">{assignment.description}</span>}
                {assignment.url && (
                  <a href={assignment.url} target="_blank" rel="noopener noreferrer" class="link text-sm">
                    Related link<span class="sr-only"> for {assignment.title} (opens in a new tab)</span> ↗
                  </a>
                )}
              </li>
            ))}
          </ul>
        </div>
      )
    }
    {
      resources.length > 0 && (
        <div>
          <h5 class="text-sm font-semibold tracking-wide text-muted uppercase">Additional resources</h5>
          <div class="mt-3"><ReadingList items={resources} /></div>
        </div>
      )
    }
  </div>
</section>
