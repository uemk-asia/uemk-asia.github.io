---
import StatusBadge from './StatusBadge.astro';
import { formatDateRange, type Activity } from '../lib/activities';

interface Props {
  activity: Activity;
  /** Heading level for the title, to keep the page outline correct. */
  headingLevel?: 'h2' | 'h3';
}

const { activity, headingLevel: Heading = 'h3' } = Astro.props;
const { title, type, summary, status, date, endDate, location, registrationUrl } = activity.data;
const when = formatDateRange(date, endDate);
const href = `/activities/${activity.id}/`;
const isOpen = status === 'upcoming' || status === 'ongoing';
---

<article class="relative flex flex-col rounded-lg border border-border bg-bg p-6 transition-colors hover:border-accent">
  <div class="flex flex-wrap items-center gap-2">
    <StatusBadge status={status} />
    <span class="text-xs font-medium tracking-wide text-muted uppercase">{type}</span>
  </div>
  <Heading class="mt-4 text-xl font-semibold leading-snug">
    <a href={href} class="after:absolute after:inset-0 after:content-[''] hover:underline">{title}</a>
  </Heading>
  <p class="mt-2 leading-relaxed text-muted">{summary}</p>
  {
    (when || location) && (
      <dl class="mt-4 space-y-1 text-sm text-muted">
        {when && (
          <div class="flex gap-2">
            <dt class="font-medium text-fg">Date</dt>
            <dd>
              <time datetime={date?.toISOString().slice(0, 10)}>{when}</time>
            </dd>
          </div>
        )}
        {location && (
          <div class="flex gap-2">
            <dt class="font-medium text-fg">Format</dt>
            <dd>{location}</dd>
          </div>
        )}
      </dl>
    )
  }
  {
    registrationUrl && isOpen && (
      <a
        href={registrationUrl}
        target="_blank" rel="noopener noreferrer"
        class="link relative z-10 mt-5 inline-flex w-fit text-sm font-medium"
      >
        Register<span class="sr-only"> for {title} (opens in a new tab)</span> ↗
      </a>
    )
  }
</article>
